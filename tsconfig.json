{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright.config.ts", "pages/**/*.ts", "fixtures/**/*.ts",
    "tests/**/*.ts", "utils/**/*.ts", "testdata/**/*.ts",
    "config/**/*.ts"
  ],
  "exclude": ["node_modules", "respaldo"]
}
